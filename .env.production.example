# =============================================================================
# FitOra Production Environment
# Copy to .env.production on the server — NEVER commit real secrets
# =============================================================================

# ── Multi-tenant SaaS ─────────────────────────────────────────────────────────
PLATFORM_BASE_DOMAIN=fitora.com

# ── Domains ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.fitora.com/api/v1
NEXT_PUBLIC_ADMIN_URL=https://admin.fitora.com

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=fitora
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS
POSTGRES_DB=fitora

# For managed RDS, override DATABASE_URL directly:
# DATABASE_URL=postgresql://user:pass@fitora.xxxxx.ap-south-1.rds.amazonaws.com:5432/fitora?schema=public&sslmode=require

# ── Redis (required in production) ────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379
# ElastiCache: rediss://fitora.xxxxx.cache.amazonaws.com:6379

# Rate limiting (Redis-backed)
GLOBAL_RATE_LIMIT_MAX=100
GLOBAL_RATE_LIMIT_WINDOW_MS=60000

# ── API Security ──────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated production origins
CORS_ORIGINS=https://fitora.com,https://www.fitora.com,https://admin.fitora.com

# Disable Swagger in production
SWAGGER_ENABLED=false

# ── Payments (Razorpay live) ──────────────────────────────────────────────────
PAYMENT_MODE=live
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Notifications ─────────────────────────────────────────────────────────────
OTP_MODE=live
EMAIL_MODE=live
SMS_MODE=live
PUSH_MODE=live
EMAIL_FROM=noreply@fitora.com
SENDGRID_API_KEY=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=FITORA
MSG91_NOTIFY_TEMPLATE_ID=
FRONTEND_URL=https://fitora.com

# Firebase FCM (push)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── AI (OpenAI) ───────────────────────────────────────────────────────────────
AI_MODE=live
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048

# ── Media ─────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Error tracking (Sentry) ───────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Deployment flags ──────────────────────────────────────────────────────────
RUN_MIGRATIONS=true
RUN_SEED=false
SUBSCRIPTION_GATE_ENABLED=true

# ── AWS (optional — ECS/Secrets Manager) ────────────────────────────────────────
# AWS_REGION=ap-south-1
# AWS_ACCOUNT_ID=
