{
  "expo": {
    "name": "FitOra Owner",
    "slug": "fitora-owner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fitora-owner",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#15157d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitora.owner",
      "infoPlist": {
        "NSCameraUsageDescription": "FitOra uses the camera to scan booking QR codes for check-in.",
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp",
          "credpay",
          "mobikwik",
          "in.fampay.app",
          "bhim",
          "amazonpay",
          "navi",
          "kiwi",
          "payzapp",
          "jupiter",
          "whatsapp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#15157d"
      },
      "package": "com.fitora.owner",
      "permissions": ["CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FitOra Owner to scan booking QR codes for check-in."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
