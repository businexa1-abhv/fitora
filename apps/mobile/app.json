{
  "expo": {
    "name": "FitOra",
    "slug": "fitora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fitora",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00b564"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitora.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00b564"
      },
      "package": "com.fitora.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications", "expo-font"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
