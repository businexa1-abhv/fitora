{
  "expo": {
    "name": "FitOra",
    "slug": "fitora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-v2.png",
    "scheme": "fitora",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon-v2.png",
      "resizeMode": "contain",
      "backgroundColor": "#ff6b00"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitora.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-v2.png",
        "backgroundColor": "#ff6b00"
      },
      "package": "com.fitora.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "FitOra uses the camera to capture your player profile photo.",
          "photosPermission": "FitOra uses your photos to set your player profile photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
