# Database
DATABASE_URL="postgresql://fitora:fitora@localhost:5440/fitora?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-use-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=

# OTP / SMS (mock logs OTP to console in development)
OTP_MODE=mock
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Email (mock logs in development; live uses SendGrid)
EMAIL_MODE=mock
EMAIL_FROM=noreply@fitora.com
SENDGRID_API_KEY=
FRONTEND_URL=http://localhost:3000

# SMS notifications (mock in development; live uses MSG91)
SMS_MODE=mock
MSG91_SENDER_ID=FITORA
MSG91_NOTIFY_TEMPLATE_ID=

# Push notifications (mock in development; live uses Firebase FCM)
PUSH_MODE=mock

# AI (mock returns structured responses without OpenAI; live requires API key)
AI_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Payments — use mock mode for local dev without Razorpay keys
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (Phase 2 — media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase (push notifications via FCM v1)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Swagger (disable in production)
SWAGGER_ENABLED=true

# Redis (required in production for rate limiting)
REDIS_URL=redis://localhost:6379

# Rate limiting
GLOBAL_RATE_LIMIT_MAX=100
GLOBAL_RATE_LIMIT_WINDOW_MS=60000

# Error tracking — optional; install @sentry/nestjs @sentry/profiling-node
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
