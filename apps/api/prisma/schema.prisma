model Court {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String              @map("tenant_id") @db.Uuid
  ownerId             String              @map("owner_id") @db.Uuid
  sportId             String              @map("sport_id") @db.Uuid
  name                String              @db.VarChar(200)
  slug                String              @db.VarChar(220)
  description         String?             @db.Text
  address             String              @db.VarChar(500)
  city                String              @db.VarChar(100)
  state               String?             @db.VarChar(100)
  pincode             String?             @db.VarChar(10)
  latitude            Decimal?            @db.Decimal(10, 7)
  longitude           Decimal?            @db.Decimal(10, 7)
  amenities           String[]            @default([])
  rules               String?             @db.Text
  defaultSlotPrice    Decimal?            @map("default_slot_price") @db.Decimal(12, 2)
  defaultSlotCapacity Int?                @map("default_slot_capacity")
  approvalStatus      CourtApprovalStatus @default(PENDING) @map("approval_status")
  rejectionReason     String?             @map("rejection_reason") @db.VarChar(500)
  approvedAt          DateTime?           @map("approved_at")
  rejectedAt          DateTime?           @map("rejected_at")
  isApproved          Boolean             @default(false) @map("is_approved")
  isActive            Boolean             @default(true) @map("is_active")
  averageRating       Decimal?            @map("average_rating") @db.Decimal(3, 2)
  deletedAt           DateTime?           @map("deleted_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  owner             User                @relation("CourtOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sport             Sport               @relation(fields: [sportId], references: [id], onDelete: Restrict)
  images            CourtImage[]
  slots             CourtSlot[]
  schedules         SlotSchedule[]
  pricingRules      SlotPricingRule[]
  closures          CourtClosure[]
  plans             MembershipPlan[]
  coupons           Coupon[]
  bookings          Booking[]
  waitlistEntries   SlotWaitlistEntry[]
  recurringBookings RecurringBooking[]
  programs          TrainingProgram[]
  communityGroups   CommunityGroup[]    @relation("CommunityHomeCourt")
  communityMatches  CommunityMatch[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([ownerId])
  @@index([sportId])
  @@index([city])
  @@index([isApproved, isActive, deletedAt])
  @@index([city, sportId, isActive])
  @@map("courts")
}

