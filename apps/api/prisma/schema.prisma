// ─── Multi-tenant SaaS ───────────────────────────────────────────────────────

model Tenant {
  id                    String       @id @default(uuid()) @db.Uuid
  name                  String       @db.VarChar(200)
  slug                  String       @unique @db.VarChar(100)
  customDomain          String?      @unique @map("custom_domain") @db.VarChar(255)
  brandName             String?      @map("brand_name") @db.VarChar(200)
  logoUrl               String?      @map("logo_url") @db.VarChar(500)
  faviconUrl            String?      @map("favicon_url") @db.VarChar(500)
  primaryColor          String?      @map("primary_color") @db.VarChar(20)
  secondaryColor        String?      @map("secondary_color") @db.VarChar(20)
  razorpayKeyId         String?      @map("razorpay_key_id") @db.VarChar(100)
  razorpayKeySecret     String?      @map("razorpay_key_secret") @db.VarChar(255)
  razorpayWebhookSecret String?      @map("razorpay_webhook_secret") @db.VarChar(255)
  useOwnPaymentAccount  Boolean      @default(false) @map("use_own_payment_account")
  ownerId               String       @map("owner_id") @db.Uuid
  status                TenantStatus @default(PENDING)
  isActive              Boolean      @default(true) @map("is_active")
  deletedAt             DateTime?    @map("deleted_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  owner               User                 @relation("TenantOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members             TenantMember[]
  trainers            TenantTrainer[]
  courts              Court[]
  membershipPlans     MembershipPlan[]
  trainingPrograms    TrainingProgram[]
  productCategories   ProductCategory[]
  products            Product[]
  coupons             Coupon[]
  payments            Payment[]
  serviceListings     ServiceListing[]
  printListings       PrintListing[]
  auditLogs           AuditLog[]
  partnerApplications PartnerApplication[]
  expenses            Expense[]
  slotTypes           SlotTypeConfig[]
  staffShifts         StaffShift[]
  payrollPeriods      PayrollPeriod[]
  playerNotes         PlayerNote[]
  playerProfiles      PlayerCrmProfile[]
  supportTickets      SupportTicket[]
  ownerSubscriptions  OwnerSubscription[]
  commissions         Commission[]
  merchantWallets     MerchantWallet[]
  settlements         Settlement[]
  financeInvoices     FinanceInvoice[]
  communityGroups     CommunityGroup[]

  @@index([ownerId])
  @@index([slug])
  @@index([customDomain])
  @@index([status, isActive, deletedAt])
  @@map("tenants")
}

model PartnerApplication {
  id            String                   @id @default(uuid()) @db.Uuid
  status        PartnerApplicationStatus @default(DRAFT)
  currentStep   String                   @default("business") @map("current_step") @db.VarChar(40)
  ownerName     String?                  @map("owner_name") @db.VarChar(200)
  businessName  String?                  @map("business_name") @db.VarChar(200)
  phone         String?                  @db.VarChar(20)
  phoneVerified Boolean                  @default(false) @map("phone_verified")
  email         String?                  @db.VarChar(255)
  city          String?                  @db.VarChar(100)
  venueAddress  String?                  @map("venue_address") @db.VarChar(500)
  state         String?                  @db.VarChar(100)
  pincode       String?                  @db.VarChar(10)
  venue         Json?
  sportsConfig  Json?                    @map("sports_config")
  trainers      Json?
  legal         Json?
  visuals       Json?
  userId        String?                  @map("user_id") @db.Uuid
  tenantId      String?                  @map("tenant_id") @db.Uuid
  submittedAt   DateTime?                @map("submitted_at")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([phone])
  @@index([userId])
  @@index([tenantId])
  @@map("partner_applications")
}

model TenantMember {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      UserRole
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, role])
  @@index([tenantId])
  @@index([userId])
  @@index([deletedAt])
  @@map("tenant_members")
}

model TenantTrainer {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("TenantTrainerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_trainers")
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  phone         String?   @unique @db.VarChar(20)
  passwordHash  String?   @map("password_hash") @db.VarChar(255)
  googleId      String?   @unique @map("google_id") @db.VarChar(255)
  firstName     String    @map("first_name") @db.VarChar(100)
  lastName      String    @map("last_name") @db.VarChar(100)
  avatarUrl     String?   @map("avatar_url") @db.VarChar(500)
  isActive      Boolean   @default(true) @map("is_active")
  emailVerified Boolean   @default(false) @map("email_verified")
  phoneVerified Boolean   @default(false) @map("phone_verified")
  lastLoginAt   DateTime? @map("last_login_at")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  roles                    UserRoleAssignment[]
  refreshTokens            RefreshToken[]
  userSessions             UserSession[]
  passwordResetTokens      PasswordResetToken[]
  parentProfile            ParentProfile?
  trainerProfile           TrainerProfile?
  wallet                   Wallet?
  courts                   Court[]                    @relation("CourtOwner")
  bookings                 Booking[]
  waitlistEntries          SlotWaitlistEntry[]
  recurringBookings        RecurringBooking[]
  membershipPurchases      MembershipPurchase[]
  payments                 Payment[]
  paymentInvoices          PaymentInvoice[]
  kidProfiles              KidProfile[]               @relation("ParentKids")
  trainerBatches           TrainingBatch[]            @relation("BatchTrainer")
  progressReports          ProgressReport[]           @relation("ReportAuthor")
  cart                     Cart?
  wishlist                 Wishlist?
  shopOrders               ShopOrder[]
  serviceListings          ServiceListing[]           @relation("ServiceListings")
  printListings            PrintListing[]             @relation("PrintListings")
  serviceOrders            ServiceOrder[]             @relation("ServiceCustomers")
  providedServiceOrders    ServiceOrder[]             @relation("ServiceProviders")
  printOrders              PrintOrder[]               @relation("PrintCustomers")
  fulfilledPrintOrders     PrintOrder[]               @relation("PrintProviders")
  printDesigns             PrintDesign[]
  notifications            Notification[]
  notificationPreference   NotificationPreference?
  scheduledNotifications   ScheduledNotification[]    @relation("ScheduledNotificationCreator")
  couponRedemptions        CouponRedemption[]
  createdCoupons           Coupon[]                   @relation("CouponCreator")
  reviews                  Review[]
  auditLogs                AuditLog[]                 @relation("AuditActor")
  deviceTokens             DeviceToken[]
  trainingNotesAuthored    TrainingNote[]             @relation("TrainerNotes")
  leaveRequests            LeaveRequest[]             @relation("TrainerLeaveRequests")
  reviewedLeaveRequests    LeaveRequest[]             @relation("LeaveRequestReviewer")
  ownedTenants             Tenant[]                   @relation("TenantOwner")
  tenantMemberships        TenantMember[]
  tenantTrainerLinks       TenantTrainer[]            @relation("TenantTrainerUser")
  partnerApplications      PartnerApplication[]
  expensesCreated          Expense[]                  @relation("ExpenseCreator")
  staffShifts              StaffShift[]               @relation("StaffShiftUser")
  payrollLines             PayrollLine[]              @relation("PayrollTrainer")
  playerNotesAuthored      PlayerNote[]               @relation("PlayerNoteAuthor")
  playerNotesAbout         PlayerNote[]               @relation("PlayerNoteSubject")
  playerCrmProfiles        PlayerCrmProfile[]
  assignedSupportTickets   SupportTicket[]            @relation("SupportTicketAssignee")
  createdSupportTickets    SupportTicket[]            @relation("SupportTicketCreator")
  ownerSubscriptions       OwnerSubscription[]        @relation("SubscriptionOwner")
  merchantWallets          MerchantWallet[]
  settlements              Settlement[]               @relation("SettlementBeneficiary")
  financeInvoices          FinanceInvoice[]           @relation("FinanceInvoiceParty")
  commissionsBenefited     Commission[]               @relation("CommissionBeneficiary")
  ownedCommunityGroups     CommunityGroup[]           @relation("CommunityGroupOwner")
  communityMemberships     CommunityGroupMember[]
  communityJoinRequests    CommunityJoinRequest[]     @relation("CommunityJoinRequester")
  reviewedJoinRequests     CommunityJoinRequest[]     @relation("CommunityJoinReviewer")
  communityMatchesCreated  CommunityMatch[]           @relation("CommunityMatchCreator")
  communityMatchPlayers    CommunityMatchPlayer[]
  communityMessages        CommunityMessage[]         @relation("CommunityMessageAuthor")
  communityReactions       CommunityMessageReaction[]
  communityAnnouncements   CommunityAnnouncement[]    @relation("CommunityAnnouncementAuthor")
  communityPollVotes       CommunityPollVote[]
  friendshipsSent          CommunityFriendship[]      @relation("FriendshipRequester")
  friendshipsReceived      CommunityFriendship[]      @relation("FriendshipAddressee")
  communityBlocksInitiated CommunityBlock[]           @relation("Blocker")
  communityBlocksReceived  CommunityBlock[]           @relation("Blocked")
  communityReportsFiled    CommunityReport[]          @relation("Reporter")
  communityFeedItems       CommunityFeedItem[]        @relation("FeedAuthor")
  communityAchievements    CommunityAchievement[]
  communityAttendance      CommunityMatchAttendance[]

  @@index([email])
  @@index([phone])
  @@index([googleId])
  @@index([deletedAt])
  @@index([isActive, deletedAt])
  @@map("users")
}

model UserRoleAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      UserRole
  entityId  String?   @map("entity_id") @db.Uuid
  grantedBy String?   @map("granted_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, entityId])
  @@index([userId])
  @@index([role])
  @@index([deletedAt])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique @db.VarChar(512)
  userId    String    @map("user_id") @db.Uuid
  sessionId String?   @map("session_id") @db.Uuid
  deviceId  String?   @map("device_id") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session UserSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model UserSession {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  deviceId           String    @map("device_id") @db.VarChar(128)
  deviceName         String?   @map("device_name") @db.VarChar(200)
  platform           String    @db.VarChar(50)
  os                 String?   @db.VarChar(100)
  appVersion         String?   @map("app_version") @db.VarChar(50)
  ipAddress          String?   @map("ip_address") @db.VarChar(64)
  userAgent          String?   @map("user_agent") @db.VarChar(500)
  refreshTokenHash   String?   @map("refresh_token_hash") @db.VarChar(512)
  accessTokenVersion Int       @default(1) @map("access_token_version")
  lastLogin          DateTime  @default(now()) @map("last_login")
  lastActive         DateTime  @default(now()) @map("last_active")
  expiresAt          DateTime  @map("expires_at")
  isActive           Boolean   @default(true) @map("is_active")
  revokedAt          DateTime? @map("revoked_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([isActive, revokedAt])
  @@map("user_sessions")
}

model OtpVerification {
  id         String     @id @default(uuid()) @db.Uuid
  phone      String     @db.VarChar(20)
  codeHash   String     @map("code_hash") @db.VarChar(255)
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at")
  verifiedAt DateTime?  @map("verified_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([phone, purpose])
  @@index([expiresAt])
  @@map("otp_verifications")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model ParentProfile {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  address          String?   @db.VarChar(500)
  city             String?   @db.VarChar(100)
  pincode          String?   @db.VarChar(10)
  alternatePhone   String?   @map("alternate_phone") @db.VarChar(20)
  emergencyContact String?   @map("emergency_contact") @db.VarChar(100)
  emergencyPhone   String?   @map("emergency_phone") @db.VarChar(20)
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@map("parent_profiles")
}

model TrainerProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  bio             String?   @db.Text
  certifications  Json?     @db.JsonB
  yearsExperience Int?      @map("years_experience")
  specializations String[]  @default([])
  isVerified      Boolean   @default(false) @map("is_verified")
  averageRating   Decimal?  @map("average_rating") @db.Decimal(3, 2)
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isVerified, deletedAt])
  @@map("trainer_profiles")
}

model TrainingNote {
  id           String    @id @default(uuid()) @db.Uuid
  trainerId    String    @map("trainer_id") @db.Uuid
  enrollmentId String?   @map("enrollment_id") @db.Uuid
  batchId      String?   @map("batch_id") @db.Uuid
  sessionDate  DateTime? @map("session_date") @db.Date
