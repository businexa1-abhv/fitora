// ─── Payments ──────────────────────────────────────────────────────────────────

model Payment {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String?           @map("tenant_id") @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  amount            Decimal           @db.Decimal(12, 2)
  currency          String            @default("INR") @db.VarChar(3)
  status            PaymentStatus     @default(PENDING)
  entityType        PaymentEntityType @map("entity_type")
  entityId          String            @map("entity_id") @db.Uuid
  idempotencyKey    String?           @unique @map("idempotency_key") @db.VarChar(100)
  razorpayOrderId   String?           @unique @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId String?           @unique @map("razorpay_payment_id") @db.VarChar(100)
  failureReason     String?           @map("failure_reason") @db.VarChar(500)
  metadata          Json?             @db.JsonB
  paidAt            DateTime?         @map("paid_at")
  refundedAt        DateTime?         @map("refunded_at")
  deletedAt         DateTime?         @map("deleted_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant  Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  invoice PaymentInvoice?

  @@index([tenantId, status])
  @@index([userId, status])
  @@index([entityType, entityId])
  @@index([status, createdAt(sort: Desc)])
  @@index([razorpayOrderId])
  @@index([deletedAt])
  @@map("payments")
}

model PaymentInvoice {
  id            String            @id @default(uuid()) @db.Uuid
  paymentId     String            @unique @map("payment_id") @db.Uuid
  invoiceNumber String            @unique @map("invoice_number") @db.VarChar(30)
  userId        String            @map("user_id") @db.Uuid
  entityType    PaymentEntityType @map("entity_type")
  entityId      String            @map("entity_id") @db.Uuid
  subtotal      Decimal           @db.Decimal(12, 2)
  tax           Decimal           @default(0) @db.Decimal(12, 2)
  total         Decimal           @db.Decimal(12, 2)
  description   String?           @db.Text
  lineItems     Json?             @map("line_items") @db.JsonB
  issuedAt      DateTime          @default(now()) @map("issued_at")
  createdAt     DateTime          @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, issuedAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([invoiceNumber])
  @@map("payment_invoices")
}

// ─── Coupons ───────────────────────────────────────────────────────────────────

model Coupon {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String?            @map("tenant_id") @db.Uuid
  code           String             @db.VarChar(50)
  description    String?            @db.VarChar(500)
  codeType       CouponCodeType     @default(PROMO) @map("code_type")
  courtId        String?            @map("court_id") @db.Uuid
  companyName    String?            @map("company_name") @db.VarChar(200)
  createdById    String?            @map("created_by_id") @db.Uuid
  discountType   CouponDiscountType @map("discount_type")
  discountValue  Decimal            @map("discount_value") @db.Decimal(12, 2)
  maxDiscount    Decimal?           @map("max_discount") @db.Decimal(12, 2)
  minOrderAmount Decimal?           @map("min_order_amount") @db.Decimal(12, 2)
  appliesTo      CouponAppliesTo    @default(ALL) @map("applies_to")
  usageLimit     Int?               @map("usage_limit")
  usageCount     Int                @default(0) @map("usage_count")
  perUserLimit   Int                @default(1) @map("per_user_limit")
  startsAt       DateTime?          @map("starts_at")
  expiresAt      DateTime?          @map("expires_at")
  isActive       Boolean            @default(true) @map("is_active")
  deletedAt      DateTime?          @map("deleted_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  court               Court?               @relation(fields: [courtId], references: [id], onDelete: Cascade)
  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy           User?                @relation("CouponCreator", fields: [createdById], references: [id], onDelete: SetNull)
  redemptions         CouponRedemption[]
  bookings            Booking[]
  membershipPurchases MembershipPurchase[]
  trainingEnrollments TrainingEnrollment[]
  shopOrders          ShopOrder[]
  serviceOrders       ServiceOrder[]
  printOrders         PrintOrder[]

  @@unique([tenantId, code])
  @@index([tenantId, code, isActive])
  @@index([code, isActive])
  @@index([courtId, codeType])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("coupons")
}

model CouponRedemption {
  id             String            @id @default(uuid()) @db.Uuid
  couponId       String            @map("coupon_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  entityType     PaymentEntityType @map("entity_type")
  entityId       String            @map("entity_id") @db.Uuid
  discountAmount Decimal           @map("discount_amount") @db.Decimal(12, 2)
  createdAt      DateTime          @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([couponId])
  @@index([userId])
  @@index([entityType, entityId])
  @@map("coupon_redemptions")
}

// ─── Wallet ────────────────────────────────────────────────────────────────────

model Wallet {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  balance   Decimal   @default(0) @db.Decimal(12, 2)
  currency  String    @default("INR") @db.VarChar(3)
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([deletedAt])
  @@map("wallets")
}

model WalletTransaction {
  id            String                @id @default(uuid()) @db.Uuid
  walletId      String                @map("wallet_id") @db.Uuid
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(12, 2)
  balanceBefore Decimal               @map("balance_before") @db.Decimal(12, 2)
  balanceAfter  Decimal               @map("balance_after") @db.Decimal(12, 2)
  referenceType PaymentEntityType?    @map("reference_type")
  referenceId   String?               @map("reference_id") @db.Uuid
