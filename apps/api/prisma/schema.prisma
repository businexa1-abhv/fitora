// ─── Kids & Training ─────────────────────────────────────────────────────────

model KidProfile {
  id               String    @id @default(uuid()) @db.Uuid
  parentId         String    @map("parent_id") @db.Uuid
  firstName        String    @map("first_name") @db.VarChar(100)
  lastName         String    @map("last_name") @db.VarChar(100)
  dateOfBirth      DateTime  @map("date_of_birth") @db.Date
  gender           Gender?
  school           String?   @db.VarChar(200)
  medicalNotes     String?   @map("medical_notes") @db.Text
  emergencyContact String    @map("emergency_contact") @db.VarChar(100)
  emergencyPhone   String    @map("emergency_phone") @db.VarChar(20)
  avatarUrl        String?   @map("avatar_url") @db.VarChar(500)
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  parent      User                 @relation("ParentKids", fields: [parentId], references: [id], onDelete: Cascade)
  enrollments TrainingEnrollment[]

  @@index([parentId])
  @@index([deletedAt])
  @@map("kid_profiles")
}

model TrainingProgram {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  courtId     String    @map("court_id") @db.Uuid
  sportId     String    @map("sport_id") @db.Uuid
  name        String    @db.VarChar(200)
  description String?   @db.Text
  minAge      Int       @map("min_age")
  maxAge      Int       @map("max_age")
  fee         Decimal   @db.Decimal(12, 2)
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  court   Court           @relation(fields: [courtId], references: [id], onDelete: Cascade)
  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sport   Sport           @relation(fields: [sportId], references: [id], onDelete: Restrict)
  batches TrainingBatch[]

  @@index([tenantId, isActive])
  @@index([courtId, isActive])
  @@index([sportId])
  @@index([deletedAt])
  @@map("training_programs")
}

model TrainingBatch {
  id          String    @id @default(uuid()) @db.Uuid
  programId   String    @map("program_id") @db.Uuid
  trainerId   String    @map("trainer_id") @db.Uuid
  name        String    @db.VarChar(200)
  schedule    String    @db.VarChar(500)
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  maxCapacity Int       @default(20) @map("max_capacity")
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  program     TrainingProgram      @relation(fields: [programId], references: [id], onDelete: Cascade)
  trainer     User                 @relation("BatchTrainer", fields: [trainerId], references: [id], onDelete: Restrict)
  enrollments   TrainingEnrollment[]
  trainingNotes TrainingNote[]

  @@index([programId])
  @@index([trainerId])
  @@index([isActive, deletedAt])
  @@map("training_batches")
}

model TrainingEnrollment {
  id            String           @id @default(uuid()) @db.Uuid
  kidId         String           @map("kid_id") @db.Uuid
  batchId       String           @map("batch_id") @db.Uuid
  couponId      String?          @map("coupon_id") @db.Uuid
  status        EnrollmentStatus @default(PENDING)
  paymentStatus PaymentStatus    @default(PENDING) @map("payment_status")
  amountPaid    Decimal          @map("amount_paid") @db.Decimal(12, 2)
  enrolledAt    DateTime?        @map("enrolled_at")
  completedAt   DateTime?        @map("completed_at")
  deletedAt     DateTime?        @map("deleted_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  kid             KidProfile         @relation(fields: [kidId], references: [id], onDelete: Cascade)
  batch           TrainingBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  coupon          Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  attendances     AttendanceRecord[]
  progressReports ProgressReport[]
  trainingNotes   TrainingNote[]

  @@unique([kidId, batchId])
  @@index([batchId, status])
  @@index([paymentStatus])
  @@index([deletedAt])
  @@map("training_enrollments")
}

model AttendanceRecord {
  id           String    @id @default(uuid()) @db.Uuid
  enrollmentId String    @map("enrollment_id") @db.Uuid
  date         DateTime  @db.Date
  present      Boolean   @default(true)
  notes        String?   @db.Text
  markedById   String?   @map("marked_by_id") @db.Uuid
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  enrollment TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, date])
  @@index([enrollmentId])
  @@index([date])
  @@map("attendance_records")
}

model ProgressReport {
  id           String    @id @default(uuid()) @db.Uuid
  enrollmentId String    @map("enrollment_id") @db.Uuid
  authorId     String    @map("author_id") @db.Uuid
  periodStart  DateTime  @map("period_start") @db.Date
  periodEnd    DateTime  @map("period_end") @db.Date
  summary      String    @db.Text
  skills       Json?     @db.JsonB
  rating       Int?
  isPublished  Boolean   @default(false) @map("is_published")
  publishedAt  DateTime? @map("published_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  enrollment TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  author     User               @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([enrollmentId, isPublished])
  @@index([authorId])
  @@index([deletedAt])
  @@map("progress_reports")
}

// ─── E-commerce ──────────────────────────────────────────────────────────────

model ProductCategory {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @db.VarChar(100)
  description String?   @db.Text
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([tenantId, slug])
  @@unique([tenantId, name])
  @@index([tenantId, isActive, deletedAt])
  @@index([slug])
  @@map("product_categories")
}

model Product {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  categoryId        String    @map("category_id") @db.Uuid
  sportId           String?   @map("sport_id") @db.Uuid
  name              String    @db.VarChar(255)
  slug              String    @db.VarChar(255)
  description       String?   @db.Text
  sku               String?   @db.VarChar(100)
  price             Decimal   @db.Decimal(12, 2)
  compareAtPrice    Decimal?  @map("compare_at_price") @db.Decimal(12, 2)
  costPrice         Decimal?  @map("cost_price") @db.Decimal(12, 2)
  stock             Int       @default(0)
  lowStockThreshold Int       @default(5) @map("low_stock_threshold")
  weightGrams       Int?      @map("weight_grams")
  isActive          Boolean   @default(true) @map("is_active")
  isFeatured        Boolean   @default(false) @map("is_featured")
  averageRating     Decimal?  @map("average_rating") @db.Decimal(3, 2)
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sport      Sport?          @relation(fields: [sportId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  variants   ProductVariant[]
  cartItems  CartItem[]
  orderItems ShopOrderItem[]
  wishlistItems WishlistItem[]
  inventoryMovements InventoryMovement[]

  @@unique([tenantId, slug])
  @@unique([tenantId, sku])
  @@index([tenantId, isActive])
  @@index([categoryId, isActive])
  @@index([sportId])
  @@index([slug])
  @@index([stock])
  @@index([isFeatured, isActive])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  url       String    @db.VarChar(500)
  altText   String?   @map("alt_text") @db.VarChar(255)
  sortOrder Int       @default(0) @map("sort_order")
  isPrimary Boolean   @default(false) @map("is_primary")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductVariant {
  id         String    @id @default(uuid()) @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  name       String    @db.VarChar(200)
  sku        String?   @unique @db.VarChar(100)
  price      Decimal?  @db.Decimal(12, 2)
  stock      Int       @default(0)
  attributes Json?     @db.JsonB
  isActive   Boolean   @default(true) @map("is_active")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems          CartItem[]
  orderItems         ShopOrderItem[]
  wishlistItems      WishlistItem[]
  inventoryMovements InventoryMovement[]

  @@index([productId, isActive])
  @@index([deletedAt])
  @@map("product_variants")
}

model Cart {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

model ShopOrder {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  orderNumber     String          @unique @map("order_number") @db.VarChar(30)
  couponId        String?         @map("coupon_id") @db.Uuid
  status          ShopOrderStatus @default(PENDING)
  paymentStatus   PaymentStatus   @default(PENDING) @map("payment_status")
  subtotalAmount  Decimal         @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @map("discount_amount") @db.Decimal(12, 2)
  shippingAmount  Decimal         @default(0) @map("shipping_amount") @db.Decimal(12, 2)
  totalAmount     Decimal         @map("total_amount") @db.Decimal(12, 2)
  shippingName    String          @map("shipping_name") @db.VarChar(200)
  shippingPhone   String          @map("shipping_phone") @db.VarChar(20)
  shippingAddress String          @map("shipping_address") @db.VarChar(500)
  shippingCity    String          @map("shipping_city") @db.VarChar(100)
  shippingPincode String          @map("shipping_pincode") @db.VarChar(10)
  trackingNumber  String?         @map("tracking_number") @db.VarChar(100)
  shippedAt       DateTime?       @map("shipped_at")
  deliveredAt     DateTime?       @map("delivered_at")
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user   User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items  ShopOrderItem[]
  invoice ShopInvoice?

  @@index([userId, status])
  @@index([orderNumber])
  @@index([paymentStatus])
  @@index([status, createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("shop_orders")
}

model ShopOrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  variantId    String?  @map("variant_id") @db.Uuid
  productName  String   @map("product_name") @db.VarChar(255)
  variantName  String?  @map("variant_name") @db.VarChar(200)
  productSku   String?  @map("product_sku") @db.VarChar(100)
  productPrice Decimal  @map("product_price") @db.Decimal(12, 2)
  quantity     Int
  lineTotal    Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  order   ShopOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("shop_order_items")
}

model ShopInvoice {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @unique @map("order_id") @db.Uuid
  invoiceNumber String   @unique @map("invoice_number") @db.VarChar(30)
  subtotal      Decimal  @db.Decimal(12, 2)
  discount      Decimal  @default(0) @db.Decimal(12, 2)
  shipping      Decimal  @default(0) @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  issuedAt      DateTime @default(now()) @map("issued_at")
  createdAt     DateTime @default(now()) @map("created_at")

  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([invoiceNumber])
  @@map("shop_invoices")
}

model Wishlist {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  wishlistId String   @map("wishlist_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  variantId  String?  @map("variant_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  wishlist Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, productId, variantId])
  @@index([wishlistId])
  @@map("wishlist_items")
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  productId      String                @map("product_id") @db.Uuid
  variantId      String?               @map("variant_id") @db.Uuid
  type           InventoryMovementType
  quantityChange Int                   @map("quantity_change")
  stockBefore    Int                   @map("stock_before")
  stockAfter     Int                   @map("stock_after")
  reason         String?               @db.VarChar(500)
  referenceType  String?               @map("reference_type") @db.VarChar(50)
  referenceId    String?               @map("reference_id") @db.Uuid
  createdById    String?               @map("created_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt(sort: Desc)])
  @@index([variantId])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

// ─── Service & Print Marketplace ─────────────────────────────────────────────

model ServiceListing {
