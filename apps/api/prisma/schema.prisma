  isActive      Boolean               @default(true) @map("is_active")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([serviceType, isActive])
  @@index([tenantId])
  @@map("commission_rules")
}

model Commission {
  id                String                @id @default(uuid()) @db.Uuid
  paymentId         String                @unique @map("payment_id") @db.Uuid
  serviceType       CommissionServiceType @map("service_type")
  grossAmount       Decimal               @map("gross_amount") @db.Decimal(12, 2)
  ratePercent       Decimal               @map("rate_percent") @db.Decimal(5, 2)
  commissionAmount  Decimal               @map("commission_amount") @db.Decimal(12, 2)
  netAmount         Decimal               @map("net_amount") @db.Decimal(12, 2)
  tenantId          String?               @map("tenant_id") @db.Uuid
  beneficiaryUserId String?               @map("beneficiary_user_id") @db.Uuid
  isReceivable      Boolean               @default(false) @map("is_receivable")
  status            String                @default("POSTED") @db.VarChar(30)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  beneficiary     User?            @relation("CommissionBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: SetNull)
  settlementLines SettlementLine[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([beneficiaryUserId, createdAt(sort: Desc)])
  @@index([serviceType])
  @@map("commissions")
}

model MerchantWallet {
  id              String             @id @default(uuid()) @db.Uuid
  ownerUserId     String             @map("owner_user_id") @db.Uuid
  tenantId        String?            @map("tenant_id") @db.Uuid
  role            MerchantWalletRole
  available       Decimal            @default(0) @db.Decimal(12, 2)
  pending         Decimal            @default(0) @db.Decimal(12, 2)
  lifetimeEarned  Decimal            @default(0) @map("lifetime_earned") @db.Decimal(12, 2)
  lifetimePaidOut Decimal            @default(0) @map("lifetime_paid_out") @db.Decimal(12, 2)
  currency        String             @default("INR") @db.VarChar(3)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  owner         User          @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  tenant        Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[]

  @@unique([ownerUserId, role])
  @@index([tenantId])
  @@index([role])
  @@map("merchant_wallets")
}

model LedgerAccount {
  id        String            @id @default(uuid()) @db.Uuid
  code      String            @unique @db.VarChar(60)
  name      String            @db.VarChar(120)
  type      LedgerAccountType
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")

  entries LedgerEntry[]

  @@map("ledger_accounts")
}

model LedgerTransaction {
  id             String   @id @default(uuid()) @db.Uuid
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(120)
  referenceType  String   @map("reference_type") @db.VarChar(60)
  referenceId    String   @map("reference_id") @db.Uuid
  memo           String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")

  entries LedgerEntry[]

  @@index([referenceType, referenceId])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  transactionId String          @map("transaction_id") @db.Uuid
  accountId     String          @map("account_id") @db.Uuid
  walletId      String?         @map("wallet_id") @db.Uuid
  debit         Decimal         @default(0) @db.Decimal(12, 2)
  credit        Decimal         @default(0) @db.Decimal(12, 2)
  entryType     LedgerEntryType @map("entry_type")
  meta          Json?
  createdAt     DateTime        @default(now()) @map("created_at")

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  wallet      MerchantWallet?   @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([accountId])
  @@index([walletId])
  @@index([createdAt(sort: Desc)])
  @@map("ledger_entries")
}

model Settlement {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String?          @map("tenant_id") @db.Uuid
  beneficiaryUserId String           @map("beneficiary_user_id") @db.Uuid
  periodStart       DateTime         @map("period_start")
  periodEnd         DateTime         @map("period_end")
  gross             Decimal          @db.Decimal(12, 2)
  commission        Decimal          @db.Decimal(12, 2)
  refunds           Decimal          @default(0) @db.Decimal(12, 2)
  adjustments       Decimal          @default(0) @db.Decimal(12, 2)
  net               Decimal          @db.Decimal(12, 2)
  status            SettlementStatus @default(PENDING)
  scheduledAt       DateTime?        @map("scheduled_at")
  paidAt            DateTime?        @map("paid_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  beneficiary User             @relation("SettlementBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Restrict)
  lines       SettlementLine[]
  payouts     Payout[]
  invoice     FinanceInvoice?

  @@index([beneficiaryUserId, status])
  @@index([tenantId, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("settlements")
}

model SettlementLine {
  id           String  @id @default(uuid()) @db.Uuid
  settlementId String  @map("settlement_id") @db.Uuid
  paymentId    String? @map("payment_id") @db.Uuid
  commissionId String? @map("commission_id") @db.Uuid
  amount       Decimal @db.Decimal(12, 2)
  description  String  @db.VarChar(300)

  settlement Settlement  @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  commission Commission? @relation(fields: [commissionId], references: [id], onDelete: SetNull)

  @@index([settlementId])
  @@map("settlement_lines")
}

model Payout {
  id               String       @id @default(uuid()) @db.Uuid
  settlementId     String       @map("settlement_id") @db.Uuid
  amount           Decimal      @db.Decimal(12, 2)
  status           PayoutStatus @default(QUEUED)
  razorpayPayoutId String?      @unique @map("razorpay_payout_id") @db.VarChar(100)
  failureReason    String?      @map("failure_reason") @db.VarChar(500)
  attempts         Int          @default(0)
  processedAt      DateTime?    @map("processed_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@index([settlementId])
  @@index([status])
  @@map("payouts")
}

model FinanceInvoice {
  id            String             @id @default(uuid()) @db.Uuid
  type          FinanceInvoiceType
  invoiceNumber String             @unique @map("invoice_number") @db.VarChar(40)
  partyUserId   String             @map("party_user_id") @db.Uuid
  tenantId      String?            @map("tenant_id") @db.Uuid
  subtotal      Decimal            @db.Decimal(12, 2)
  gst           Decimal            @default(0) @db.Decimal(12, 2)
  total         Decimal            @db.Decimal(12, 2)
  lineItems     Json               @map("line_items")
  pdfUrl        String?            @map("pdf_url") @db.VarChar(500)
  settlementId  String?            @unique @map("settlement_id") @db.Uuid
  paymentId     String?            @map("payment_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at")

  party        User               @relation("FinanceInvoiceParty", fields: [partyUserId], references: [id], onDelete: Restrict)
  tenant       Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  settlement   Settlement?        @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  subscription OwnerSubscription?

  @@index([partyUserId, createdAt(sort: Desc)])
  @@index([type])
  @@map("finance_invoices")
}

model WebhookEvent {
  id          String             @id @default(uuid()) @db.Uuid
  provider    String             @db.VarChar(40)
  eventId     String             @unique @map("event_id") @db.VarChar(120)
  eventType   String             @map("event_type") @db.VarChar(80)
  payload     Json
  status      WebhookEventStatus @default(RECEIVED)
  processedAt DateTime?          @map("processed_at")
  error       String?            @db.VarChar(500)
  createdAt   DateTime           @default(now()) @map("created_at")

  @@index([provider, status])
  @@index([createdAt(sort: Desc)])
  @@map("webhook_events")
}

/// Durable realtime fan-out. Written in the same transaction as slot mutations.
model RealtimeOutbox {
  id          String               @id @default(uuid()) @db.Uuid
  eventId     String               @unique @map("event_id") @db.Uuid
  eventType   String               @map("event_type") @db.VarChar(80)
  payload     Json
  status      RealtimeOutboxStatus @default(PENDING)
  attempts    Int                  @default(0)
  lastError   String?              @map("last_error") @db.VarChar(1000)
  availableAt DateTime             @default(now()) @map("available_at")
  publishedAt DateTime?            @map("published_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([eventType, createdAt(sort: Desc)])
  @@map("realtime_outbox")
}

