}

model ServiceOrder {
  id                String             @id @default(uuid()) @db.Uuid
  orderNumber       String             @unique @map("order_number") @db.VarChar(30)
  userId            String             @map("user_id") @db.Uuid
  listingId         String             @map("listing_id") @db.Uuid
  providerId        String             @map("provider_id") @db.Uuid
  couponId          String?            @map("coupon_id") @db.Uuid
  status            ServiceOrderStatus @default(PENDING)
  paymentStatus     PaymentStatus      @default(PENDING) @map("payment_status")
  subtotalAmount    Decimal            @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount    Decimal            @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount       Decimal            @map("total_amount") @db.Decimal(12, 2)
  customerNotes     String?            @map("customer_notes") @db.Text
  equipmentDetails  String?            @map("equipment_details") @db.Text
  pickupAddress     String             @map("pickup_address") @db.VarChar(500)
  pickupPhone       String             @map("pickup_phone") @db.VarChar(20)
  pickupCity        String             @map("pickup_city") @db.VarChar(100)
  providerNotes     String?            @map("provider_notes") @db.Text
