// =============================================================================
// FitOra — Production PostgreSQL Schema
// =============================================================================
// Design principles:
//   • UUID primary keys (@db.Uuid)
//   • Soft delete via deletedAt on all business entities
//   • createdAt / updatedAt on all mutable models
//   • Explicit indexes on FKs, status fields, and query hot paths
//   • Cascade on owned/child rows; Restrict on financial ledger rows
//   • Monetary values: Decimal(12, 2)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

