// =============================================================================
// FitOra — Production PostgreSQL Schema
// =============================================================================
// Design principles:
//   • UUID primary keys (@db.Uuid)
//   • Soft delete via deletedAt on all business entities
//   • createdAt / updatedAt on all mutable models
//   • Explicit indexes on FKs, status fields, and query hot paths
//   • Cascade on owned/child rows; Restrict on financial ledger rows
//   • Monetary values: Decimal(12, 2)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  COURT_OWNER
  TRAINER
  PLAYER
  SERVICE_PROVIDER
  PRINTER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MembershipDuration {
  HOURLY
  DAILY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentEntityType {
  BOOKING
  MEMBERSHIP
  TRAINING
  SHOP_ORDER
  SERVICE_ORDER
  PRINT_ORDER
  WALLET_TOPUP
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  SUSPENDED
}

enum ShopOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum InventoryMovementType {
  ADJUSTMENT
  SALE
  RETURN
  RESTOCK
}

enum ServiceOrderStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum PrintOrderStatus {
  PENDING
  ACCEPTED
  DESIGN_REVIEW
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ServiceCategory {
  STRINGING
  BAT_REPAIR
  BALL_REPAIR
  GRIP_REPLACEMENT
  EQUIPMENT_REPAIR
  EQUIPMENT_RENTAL
  OTHER
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponAppliesTo {
  ALL
  BOOKING
  MEMBERSHIP
  TRAINING
  SHOP_ORDER
  SERVICE_ORDER
  PRINT_ORDER
}

enum CouponCodeType {
  PROMO
  CORPORATE
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  REFUND
  CASHBACK
  ADJUSTMENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  MEMBERSHIP_ACTIVATED
  MEMBERSHIP_EXPIRING
  TRAINING_ENROLLED
  TRAINING_PROGRESS
  TRAINING_REMINDER
  TRAINER_NEW_ENROLLMENT
  LEAVE_REQUEST_UPDATE
  ORDER_CONFIRMED
  ORDER_SHIPPED
  SERVICE_ORDER_UPDATE
  PRINT_ORDER_UPDATE
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  WALLET_CREDIT
  REVIEW_REQUEST
  ADMIN_BROADCAST
  SYSTEM
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ScheduledNotificationStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ReviewTargetType {
  COURT
  PRODUCT
  TRAINER
  SERVICE_PROVIDER
  PRINTER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  PAYMENT
  REFUND
  STATUS_CHANGE
}

enum CourtApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SlotPricingRuleType {
  PEAK
  WEEKEND
  HOLIDAY
}

enum ClosureReason {
  BLOCKED
  MAINTENANCE
  HOLIDAY
}

enum SettingScope {
  PLATFORM
  TENANT
  COURT
  USER
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum OtpPurpose {
  LOGIN
  REGISTER
  VERIFY_PHONE
}

// ─── Multi-tenant SaaS ───────────────────────────────────────────────────────

model Tenant {
  id                    String       @id @default(uuid()) @db.Uuid
  name                  String       @db.VarChar(200)
  slug                  String       @unique @db.VarChar(100)
  customDomain          String?      @unique @map("custom_domain") @db.VarChar(255)
  brandName             String?      @map("brand_name") @db.VarChar(200)
  logoUrl               String?      @map("logo_url") @db.VarChar(500)
  faviconUrl            String?      @map("favicon_url") @db.VarChar(500)
  primaryColor          String?      @map("primary_color") @db.VarChar(20)
  secondaryColor        String?      @map("secondary_color") @db.VarChar(20)
  razorpayKeyId         String?      @map("razorpay_key_id") @db.VarChar(100)
  razorpayKeySecret     String?      @map("razorpay_key_secret") @db.VarChar(255)
  razorpayWebhookSecret String?      @map("razorpay_webhook_secret") @db.VarChar(255)
  useOwnPaymentAccount  Boolean      @default(false) @map("use_own_payment_account")
  ownerId               String       @map("owner_id") @db.Uuid
  status                TenantStatus @default(PENDING)
  isActive              Boolean      @default(true) @map("is_active")
  deletedAt             DateTime?    @map("deleted_at")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  owner             User              @relation("TenantOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members           TenantMember[]
  trainers          TenantTrainer[]
  courts            Court[]
  membershipPlans   MembershipPlan[]
  trainingPrograms  TrainingProgram[]
  productCategories ProductCategory[]
  products          Product[]
  coupons           Coupon[]
  payments          Payment[]
  serviceListings   ServiceListing[]
  printListings     PrintListing[]
  auditLogs         AuditLog[]

  @@index([ownerId])
  @@index([slug])
  @@index([customDomain])
  @@index([status, isActive, deletedAt])
  @@map("tenants")
}

model TenantMember {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      UserRole
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, role])
  @@index([tenantId])
  @@index([userId])
  @@index([deletedAt])
  @@map("tenant_members")
}

model TenantTrainer {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation("TenantTrainerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_trainers")
}

// ─── Users & Auth ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  phone         String?   @unique @db.VarChar(20)
  passwordHash  String?   @map("password_hash") @db.VarChar(255)
  googleId      String?   @unique @map("google_id") @db.VarChar(255)
  firstName     String    @map("first_name") @db.VarChar(100)
  lastName      String    @map("last_name") @db.VarChar(100)
  avatarUrl     String?   @map("avatar_url") @db.VarChar(500)
  isActive      Boolean   @default(true) @map("is_active")
  emailVerified Boolean   @default(false) @map("email_verified")
  phoneVerified Boolean   @default(false) @map("phone_verified")
  lastLoginAt   DateTime? @map("last_login_at")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  roles                 UserRoleAssignment[]
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  parentProfile         ParentProfile?
  trainerProfile        TrainerProfile?
  wallet                Wallet?
  courts                Court[]              @relation("CourtOwner")
  bookings              Booking[]
  membershipPurchases   MembershipPurchase[]
  payments              Payment[]
  paymentInvoices       PaymentInvoice[]
  kidProfiles           KidProfile[]         @relation("ParentKids")
  trainerBatches        TrainingBatch[]      @relation("BatchTrainer")
  progressReports       ProgressReport[]     @relation("ReportAuthor")
  cart                  Cart?
  wishlist              Wishlist?
  shopOrders            ShopOrder[]
  serviceListings       ServiceListing[]     @relation("ServiceListings")
  printListings         PrintListing[]       @relation("PrintListings")
  serviceOrders         ServiceOrder[]       @relation("ServiceCustomers")
  providedServiceOrders ServiceOrder[]       @relation("ServiceProviders")
  printOrders           PrintOrder[]         @relation("PrintCustomers")
  fulfilledPrintOrders  PrintOrder[]         @relation("PrintProviders")
  printDesigns          PrintDesign[]
  notifications         Notification[]
  notificationPreference NotificationPreference?
  scheduledNotifications ScheduledNotification[] @relation("ScheduledNotificationCreator")
  couponRedemptions     CouponRedemption[]
  createdCoupons        Coupon[]             @relation("CouponCreator")
  reviews               Review[]
  auditLogs             AuditLog[]           @relation("AuditActor")
  deviceTokens          DeviceToken[]
  trainingNotesAuthored TrainingNote[]     @relation("TrainerNotes")
  leaveRequests         LeaveRequest[]     @relation("TrainerLeaveRequests")
  reviewedLeaveRequests LeaveRequest[]     @relation("LeaveRequestReviewer")
  ownedTenants          Tenant[]           @relation("TenantOwner")
  tenantMemberships     TenantMember[]
  tenantTrainerLinks    TenantTrainer[]    @relation("TenantTrainerUser")

  @@index([email])
  @@index([phone])
  @@index([googleId])
  @@index([deletedAt])
  @@index([isActive, deletedAt])
  @@map("users")
}

model UserRoleAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      UserRole
  entityId  String?   @map("entity_id") @db.Uuid
  grantedBy String?   @map("granted_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, entityId])
  @@index([userId])
  @@index([role])
  @@index([deletedAt])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique @db.VarChar(512)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OtpVerification {
  id         String     @id @default(uuid()) @db.Uuid
  phone      String     @db.VarChar(20)
  codeHash   String     @map("code_hash") @db.VarChar(255)
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at")
  verifiedAt DateTime?  @map("verified_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([phone, purpose])
  @@index([expiresAt])
  @@map("otp_verifications")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model ParentProfile {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  address          String?   @db.VarChar(500)
  city             String?   @db.VarChar(100)
  pincode          String?   @db.VarChar(10)
  alternatePhone   String?   @map("alternate_phone") @db.VarChar(20)
  emergencyContact String?   @map("emergency_contact") @db.VarChar(100)
  emergencyPhone   String?   @map("emergency_phone") @db.VarChar(20)
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@map("parent_profiles")
}

model TrainerProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  bio             String?   @db.Text
  certifications  Json?     @db.JsonB
  yearsExperience Int?      @map("years_experience")
  specializations String[]  @default([])
  isVerified      Boolean   @default(false) @map("is_verified")
  averageRating   Decimal?  @map("average_rating") @db.Decimal(3, 2)
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isVerified, deletedAt])
  @@map("trainer_profiles")
}

model TrainingNote {
  id           String    @id @default(uuid()) @db.Uuid
  trainerId    String    @map("trainer_id") @db.Uuid
  enrollmentId String?   @map("enrollment_id") @db.Uuid
  batchId      String?   @map("batch_id") @db.Uuid
  sessionDate  DateTime? @map("session_date") @db.Date
  title        String?   @db.VarChar(200)
  content      String    @db.Text
  isPrivate    Boolean   @default(true) @map("is_private")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  trainer    User                @relation("TrainerNotes", fields: [trainerId], references: [id], onDelete: Cascade)
  enrollment TrainingEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  batch      TrainingBatch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([trainerId, deletedAt])
  @@index([enrollmentId])
  @@index([batchId])
  @@map("training_notes")
}

model LeaveRequest {
  id           String             @id @default(uuid()) @db.Uuid
  trainerId    String             @map("trainer_id") @db.Uuid
  startDate    DateTime           @map("start_date") @db.Date
  endDate      DateTime           @map("end_date") @db.Date
  reason       String             @db.Text
  status       LeaveRequestStatus @default(PENDING)
  reviewNote   String?            @map("review_note") @db.Text
  reviewedById String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?          @map("reviewed_at")
  deletedAt    DateTime?          @map("deleted_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  trainer    User  @relation("TrainerLeaveRequests", fields: [trainerId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("LeaveRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([trainerId, status])
  @@index([deletedAt])
  @@map("leave_requests")
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @db.VarChar(512)
  platform  String   @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId, isActive])
  @@map("device_tokens")
}

// ─── Sports ──────────────────────────────────────────────────────────────────

model Sport {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  iconUrl     String?   @map("icon_url") @db.VarChar(500)
  description String?   @db.Text
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  courts           Court[]
  trainingPrograms TrainingProgram[]
  products         Product[]
  serviceListings  ServiceListing[]

  @@index([slug])
  @@index([isActive, deletedAt])
  @@map("sports")
}

// ─── Courts & Booking ────────────────────────────────────────────────────────

model Court {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  sportId       String    @map("sport_id") @db.Uuid
  name          String    @db.VarChar(200)
  slug          String    @db.VarChar(220)
  description   String?   @db.Text
  address       String    @db.VarChar(500)
  city          String    @db.VarChar(100)
  state         String?   @db.VarChar(100)
  pincode       String?   @db.VarChar(10)
  latitude      Decimal?  @db.Decimal(10, 7)
  longitude     Decimal?  @db.Decimal(10, 7)
  amenities         String[]            @default([])
  rules             String?             @db.Text
  defaultSlotPrice  Decimal?            @map("default_slot_price") @db.Decimal(12, 2)
  approvalStatus    CourtApprovalStatus @default(PENDING) @map("approval_status")
  rejectionReason   String?             @map("rejection_reason") @db.VarChar(500)
  approvedAt        DateTime?           @map("approved_at")
  rejectedAt        DateTime?           @map("rejected_at")
  isApproved        Boolean             @default(false) @map("is_approved")
  isActive      Boolean   @default(true) @map("is_active")
  averageRating Decimal?  @map("average_rating") @db.Decimal(3, 2)
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  owner    User              @relation("CourtOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sport    Sport             @relation(fields: [sportId], references: [id], onDelete: Restrict)
  images   CourtImage[]
  slots         CourtSlot[]
  schedules     SlotSchedule[]
  pricingRules  SlotPricingRule[]
  closures      CourtClosure[]
  plans         MembershipPlan[]
  coupons       Coupon[]
  bookings Booking[]
  programs TrainingProgram[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([ownerId])
  @@index([sportId])
  @@index([city])
  @@index([isApproved, isActive, deletedAt])
  @@index([city, sportId, isActive])
  @@map("courts")
}

model CourtImage {
  id        String    @id @default(uuid()) @db.Uuid
  courtId   String    @map("court_id") @db.Uuid
  url       String    @db.VarChar(500)
  altText   String?   @map("alt_text") @db.VarChar(255)
  sortOrder Int       @default(0) @map("sort_order")
  isPrimary Boolean   @default(false) @map("is_primary")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId, sortOrder])
  @@index([courtId, isPrimary])
  @@map("court_images")
}

model CourtSlot {
  id          String         @id @default(uuid()) @db.Uuid
  courtId     String         @map("court_id") @db.Uuid
  scheduleId  String?        @map("schedule_id") @db.Uuid
  startTime   DateTime       @map("start_time")
  endTime     DateTime       @map("end_time")
  price       Decimal        @db.Decimal(12, 2)
  isBlocked   Boolean        @default(false) @map("is_blocked")
  blockReason ClosureReason? @map("block_reason")
  notes       String?        @db.VarChar(500)
  deletedAt   DateTime?      @map("deleted_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  court    Court         @relation(fields: [courtId], references: [id], onDelete: Cascade)
  schedule SlotSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  booking  Booking?

  @@index([courtId, startTime])
  @@index([courtId, startTime, endTime])
  @@index([scheduleId])
  @@index([startTime])
  @@index([deletedAt])
  @@map("court_slots")
}

model SlotSchedule {
  id              String    @id @default(uuid()) @db.Uuid
  courtId         String    @map("court_id") @db.Uuid
  name            String    @db.VarChar(200)
  daysOfWeek      Int[]     @map("days_of_week")
  startHour       Int       @map("start_hour")
  startMinute     Int       @default(0) @map("start_minute")
  endHour         Int       @map("end_hour")
  endMinute       Int       @default(0) @map("end_minute")
  durationMinutes Int       @map("duration_minutes")
  basePrice       Decimal   @map("base_price") @db.Decimal(12, 2)
  isActive        Boolean   @default(true) @map("is_active")
  validFrom       DateTime? @map("valid_from") @db.Date
  validUntil      DateTime? @map("valid_until") @db.Date
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  court Court       @relation(fields: [courtId], references: [id], onDelete: Cascade)
  slots CourtSlot[]

  @@index([courtId, isActive, deletedAt])
  @@map("slot_schedules")
}

model SlotPricingRule {
  id          String              @id @default(uuid()) @db.Uuid
  courtId     String              @map("court_id") @db.Uuid
  type        SlotPricingRuleType
  name        String              @db.VarChar(200)
  multiplier  Decimal             @default(1) @db.Decimal(5, 2)
  fixedPrice  Decimal?            @map("fixed_price") @db.Decimal(12, 2)
  startHour   Int?                @map("start_hour")
  endHour     Int?                @map("end_hour")
  daysOfWeek  Int[]               @default([]) @map("days_of_week")
  holidayDate DateTime?           @map("holiday_date") @db.Date
  priority    Int                 @default(0)
  isActive    Boolean             @default(true) @map("is_active")
  deletedAt   DateTime?           @map("deleted_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([courtId, type, isActive, deletedAt])
  @@index([courtId, holidayDate])
  @@map("slot_pricing_rules")
}

model CourtClosure {
