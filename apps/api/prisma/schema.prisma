  provider User           @relation("ServiceProviders", fields: [providerId], references: [id], onDelete: Restrict)
  coupon   Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([providerId, status])
  @@index([listingId])
  @@index([orderNumber])
  @@index([paymentStatus])
  @@index([deletedAt])
  @@map("service_orders")
