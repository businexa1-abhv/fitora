// ─── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String              @db.VarChar(255)
  body      String              @db.Text
  data      Json?               @db.JsonB
  readAt    DateTime?           @map("read_at")
  sentAt    DateTime?           @map("sent_at")
  deletedAt DateTime?           @map("deleted_at")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([type])
  @@index([deletedAt])
  @@map("notifications")
}

model NotificationPreference {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  emailEnabled Boolean  @default(true) @map("email_enabled")
  smsEnabled   Boolean  @default(true) @map("sms_enabled")
  pushEnabled  Boolean  @default(true) @map("push_enabled")
  inAppEnabled Boolean  @default(true) @map("in_app_enabled")
  typeOverrides Json?   @map("type_overrides") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationDelivery {
  id             String                     @id @default(uuid()) @db.Uuid
  notificationId String                     @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  errorMessage   String?                    @map("error_message") @db.Text
  sentAt         DateTime?                  @map("sent_at")
  createdAt      DateTime                   @default(now()) @map("created_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([status])
  @@map("notification_deliveries")
}

model ScheduledNotification {
  id          String                      @id @default(uuid()) @db.Uuid
  title       String                      @db.VarChar(255)
  body        String                      @db.Text
  scheduledAt DateTime                    @map("scheduled_at")
  status      ScheduledNotificationStatus @default(PENDING)
  roles       String[]                    @default([])
  userIds     String[]                    @default([]) @map("user_ids")
  channels    NotificationChannel[]       @default([IN_APP, EMAIL, PUSH])
  createdById String                      @map("created_by_id") @db.Uuid
  processedAt DateTime?                   @map("processed_at")
  resultMeta  Json?                       @map("result_meta") @db.JsonB
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")

  createdBy User @relation("ScheduledNotificationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([scheduledAt, status])
  @@index([createdById])
  @@map("scheduled_notifications")
}

// ─── Audit & Settings ────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String?     @map("tenant_id") @db.Uuid
  actorId    String?     @map("actor_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(100)
  entityId   String?     @map("entity_id") @db.Uuid
  before     Json?       @db.JsonB
  after      Json?       @db.JsonB
  ipAddress  String?     @map("ip_address") @db.VarChar(45)
  userAgent  String?     @map("user_agent") @db.VarChar(500)
  createdAt  DateTime    @default(now()) @map("created_at")

  actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Setting {
  id          String       @id @default(uuid()) @db.Uuid
  key         String       @db.VarChar(100)
  value       Json         @db.JsonB
  scope       SettingScope @default(PLATFORM)
  scopeId     String?      @map("scope_id") @db.Uuid
  description String?      @db.VarChar(500)
  isPublic    Boolean      @default(false) @map("is_public")
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@unique([key, scope, scopeId])
  @@index([scope, scopeId])
  @@index([key])
  @@index([deletedAt])
  @@map("settings")
}

// ─── Legacy compatibility views (API migration aliases) ───────────────────────
// The existing API uses these Prisma model names — map to new tables:
//
//   Membership          → use MembershipPurchase  (@@map membership_purchases)
//   MarketplaceOrder    → split into ServiceOrder + PrintOrder
//   Product.category    → use ProductCategory relation
//   Court.sportType     → use Sport relation
//   Court.images[]      → use CourtImage relation
//
// Run `pnpm db:migrate` after updating services to use new model names.
