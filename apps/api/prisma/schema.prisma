// ─── Payments ──────────────────────────────────────────────────────────────────

model Payment {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String?           @map("tenant_id") @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  amount            Decimal           @db.Decimal(12, 2)
  currency          String            @default("INR") @db.VarChar(3)
  status            PaymentStatus     @default(PENDING)
  entityType        PaymentEntityType @map("entity_type")
  entityId          String            @map("entity_id") @db.Uuid
  idempotencyKey    String?           @unique @map("idempotency_key") @db.VarChar(100)
  razorpayOrderId   String?           @unique @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId String?           @unique @map("razorpay_payment_id") @db.VarChar(100)
  failureReason     String?           @map("failure_reason") @db.VarChar(500)
  metadata          Json?             @db.JsonB
  paidAt            DateTime?         @map("paid_at")
  refundedAt        DateTime?         @map("refunded_at")
  deletedAt         DateTime?         @map("deleted_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant  Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
