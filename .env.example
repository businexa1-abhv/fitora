# =============================================================================
# FitOra — Root Environment Variables Reference
# Copy app-specific examples from apps/*/.env.example
# =============================================================================

# ── API (apps/api/.env) ──────────────────────────────────────────────────────
# DATABASE_URL=postgresql://fitora:fitora@localhost:5440/fitora?schema=public
# REDIS_URL=redis://localhost:6379
# PORT=3001
# NODE_ENV=development
# JWT_SECRET=
# JWT_EXPIRES_IN=15m
# JWT_REFRESH_SECRET=
# JWT_REFRESH_EXPIRES_IN=7d
# CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3010,http://localhost:3011,http://localhost:3012
# PAYMENT_MODE=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Web (apps/web/.env.local) ────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# ── Admin (apps/admin/.env.local) ────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ── Player App (apps/player-app/.env) ────────────────────────────────────────
# EXPO_PUBLIC_API_URL=http://localhost:3001/api/v1
